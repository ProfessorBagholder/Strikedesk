//@version=5
// Strikedesk strike companion.
// On-chart 0–100 sketch of the desk formula. The RS leg is a proxy versus
// the benchmark symbol, not the scan-wide percentile the desk draws in the
// square. Thresholds match BadgeParams defaults. This does not place orders.
indicator("Strikedesk Strike", overlay=false, precision=0)

benchmark = input.symbol("AMEX:SPY", "Benchmark")
sma50 = ta.sma(close, 50)
sma150 = ta.sma(close, 150)
sma200 = ta.sma(close, 200)
ema10 = ta.ema(close, 10)
adr = ta.sma((high - low) / close, 20)
dollars = ta.sma(close * volume, 20)
hi63 = ta.highest(high, 63)
range10 = close > 0 ? (ta.highest(high, 10) - ta.lowest(low, 10)) / close : 1.0
ret63 = close[63] > 0 ? close / close[63] - 1.0 : 0.0
span = high - low
closePos = span > 0 ? (close - low) / span : 1.0
relVol = ta.sma(volume, 20) > 0 ? volume / ta.sma(volume, 20) : 0.0

bench = request.security(benchmark, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
excess = (close[63] > 0 ? close / close[63] - 1.0 : na) - (bench[63] > 0 ? bench / bench[63] - 1.0 : na)
rsProxy = na(excess) ? 50.0 : math.max(1.0, math.min(99.0, math.round(50.0 + excess * 100.0)))

maPts = (close > sma50 ? 8.0 : 0.0) + (sma50 > sma150 ? 6.0 : 0.0) + (sma150 > sma200 and sma200 > sma200[21] ? 6.0 : 0.0)
rsPts = rsProxy / 99.0 * 20.0
dd = hi63 > 0 ? 1.0 - close / hi63 : 1.0
locPts = dd <= 0.08 ? 15.0 : dd <= 0.15 ? 10.0 : dd <= 0.25 ? 5.0 : 0.0
if ema10 > 0 and close > ema10 * 1.12
    locPts := math.max(0.0, locPts - 8.0)
tightPts = range10 <= 0.08 ? 15.0 : range10 <= 0.12 ? 10.0 : range10 <= 0.18 ? 5.0 : 0.0
if ret63 < 0.15
    tightPts := math.min(tightPts, 8.0)
closePts = (closePos >= 0.97 ? 5.0 : closePos >= 0.70 ? 3.0 : 0.0) + (relVol >= 1.2 ? 5.0 : relVol >= 0.8 ? 2.0 : 0.0)
closePts := math.min(closePts, 10.0)
adrPts = adr >= 0.035 and adr <= 0.08 ? 10.0 : (adr >= 0.025 and adr < 0.035) or (adr > 0.08 and adr <= 0.12) ? 6.0 : (adr >= 0.015 and adr < 0.025) or (adr > 0.12 and adr <= 0.18) ? 3.0 : 0.0
liqPts = dollars >= 20000000 ? 10.0 : dollars >= 5000000 ? 7.0 : dollars >= 1000000 ? 4.0 : 0.0
strike = math.round(math.max(0.0, math.min(100.0, maPts + rsPts + locPts + tightPts + closePts + adrPts + liqPts)))

tone = strike >= 70 ? color.lime : strike >= 50 ? color.yellow : color.red
plot(strike, "Strike", color=tone, linewidth=2)
hline(70, "Green", color=color.new(color.lime, 60))
hline(50, "Gold", color=color.new(color.yellow, 60))

if barstate.isconfirmed and strike >= 70
    alert('{"symbol":"' + syminfo.ticker + '","badge":"STRIKE","strike":' + str.tostring(strike) + ',"price":' + str.tostring(close, "#.##") + ',"time":"' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '","message":"Strike zone. Not an order."}', alert.freq_once_per_bar_close)
