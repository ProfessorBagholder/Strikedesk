# Copy to .env if you want local overrides. Never commit .env.
# The API reads these from the process environment. Defaults live in config/screener.toml.

STRIKEDESK_HOST=127.0.0.1
STRIKEDESK_PORT=8787
STRIKEDESK_CONFIG=config/screener.toml
STRIKEDESK_DATA_SOURCE=fixtures

# Leave empty to accept webhook posts on localhost with no shared secret.
# Set a token and send it as the X-Strikedesk-Token header from TradingView.
STRIKEDESK_WEBHOOK_TOKEN=
